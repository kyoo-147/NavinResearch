[Unit]
Description=Build privacy-preserving Navin Research visitor aggregates
ConditionPathExists=/var/lib/navin-analytics/DBIP-City-Lite.mmdb
ConditionPathExists=/var/log/nginx/navinresearch.access.log
ConditionPathExists=/opt/navin-analytics/.venv/bin/python
ConditionPathExists=/opt/navin-analytics/run-production.sh

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
WorkingDirectory=/opt/navin-analytics
ExecStart=/opt/navin-analytics/run-production.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/log/nginx
ReadWritePaths=/var/lib/navin-analytics
