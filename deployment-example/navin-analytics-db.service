[Unit]
Description=Refresh the DB-IP City Lite database for Navin analytics
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0027
ExecStart=/opt/navin-analytics/update-dbip-city.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/navin-analytics
